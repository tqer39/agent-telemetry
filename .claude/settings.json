{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/.standards/cache/dev-standards\" hook",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/.standards/cache/dev-standards\" hook",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/.standards/cache/dev-standards\" hook",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
