# Copy to .env (git-ignored) and fill in.
GF_SECURITY_ADMIN_USER=admin
# Required. Grafana refuses to start without it. e.g. `openssl rand -base64 24`
GF_SECURITY_ADMIN_PASSWORD=

# Collector debug exporter: basic | normal | detailed
# Use "detailed" while checking which signals the Desktop apps actually send.
DEBUG_VERBOSITY=basic

# session-indexer
LOOKBACK_DAYS=14
SCAN_INTERVAL_SECONDS=60
# Gaps between events longer than this are treated as idle (not "active time").
IDLE_GAP_SECONDS=300
# Override if your config dirs are elsewhere.
# CLAUDE_HOME=/Users/you/.claude
# CODEX_HOME=/Users/you/.codex

PROMETHEUS_RETENTION=90d
