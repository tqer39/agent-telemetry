          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (tool,session_id,project) (agent_session_tool_failures{tool=~\"$tool\",project=~\"$project\"} and on(tool,session_id,project) (agent_session_start_time_seconds{tool=~\"$tool\",project=~\"$project\"} >= ${__from:date:seconds}))",
          "refId": "G",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (tool,session_id,project) (agent_session_repeated_commands{tool=~\"$tool\",project=~\"$project\"} and on(tool,session_id,project) (agent_session_start_time_seconds{tool=~\"$tool\",project=~\"$project\"} >= ${__from:date:seconds}))",
          "refId": "H",
          "legendFormat": "",
          "instant": true,
          "range": false,
