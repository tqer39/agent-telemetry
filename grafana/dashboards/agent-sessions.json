      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "start",
              "Value #B": "active",
              "Value #C": "wall",
              "Value #D": "tokens",
              "Value #E": "cache",
              "Value #F": "calls",
              "Value #G": "fails",
              "Value #H": "repeated",
              "Value #I": "retries"
            },
            "indexByName": {
              "tool": 0,
              "project": 1,
              "session_id": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
