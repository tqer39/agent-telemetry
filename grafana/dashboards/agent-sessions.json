        "orientation": "horizontal"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Token-weighted: cache_read / all input-side tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 2
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tool) (agent_session_tokens{tool=~\"$tool\",project=~\"$project\",type=\"cache_read\"} and on(tool,session_id,project) (agent_session_start_time_seconds{tool=~\"$tool\",project=~\"$project\"} >= ${__from:date:seconds})) / sum by (tool) (agent_session_tokens{tool=~\"$tool\",project=~\"$project\",type=~\"input|cache_read|cache_creation\"} and on(tool,session_id,project) (agent_session_start_time_seconds{tool=~\"$tool\",project=~\"$project\"} >= ${__from:date:seconds}))",
          "refId": "A",
          "legendFormat": "{{tool}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal"
      }
    },
    {
      "id": 6,
