          },
          "expr": "max by (tool,session_id,project) (agent_session_tool_calls{tool=~\"$tool\",project=~\"$project\"} and on(tool,session_id,project) (agent_session_start_time_seconds{tool=~\"$tool\",project=~\"$project\"} >= ${__from:date:seconds}))",
          "refId": "F",
