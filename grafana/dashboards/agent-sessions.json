          "expr": "sum by (tool) (agent_session_tokens{tool=~\"$tool\",project=~\"$project\",type=~\"input|output\"} and on(tool,session_id,project) (agent_session_start_time_seconds{tool=~\"$tool\",project=~\"$project\"} >= ${__from:date:seconds}))",
          "refId": "A",
