            "uid": "prometheus"
          },
          "expr": "max by (tool,session_id,project) (agent_session_retries_after_failure{tool=~\"$tool\",project=~\"$project\"} and on(tool,session_id,project) (agent_session_start_time_seconds{tool=~\"$tool\",project=~\"$project\"} >= ${__from:date:seconds}))",
