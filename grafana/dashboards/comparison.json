{
  "uid": "tool-comparison",
  "title": "ツールの比較",
  "description": "Claude Code・Codex CLI・Gemini CLI のコスト、処理時間、使用量を比較します。",
  "tags": ["llm-telemetry", "comparison"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "イベントの発生状況",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ツール別のイベント発生状況",
      "description": "Loki に記録されたツール別のイベント発生率です。",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"}[5m]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "pointSize": 5, "showPoints": "auto" },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean", "max"] } }
    },
    {
      "id": 3,
      "type": "row",
      "title": "トークン使用量",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "ツール別トークン数",
      "description": "Claude Code・Gemini・Codex のトークン内訳です。ツールによって集計方法が異なります。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (claude_code_token_usage_tokens_total)",
          "legendFormat": "Claude Code {{type}}",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (gen_ai_token_type) (gen_ai_client_token_usage_sum{service_name=\"gemini-cli\"})",
          "legendFormat": "Gemini {{gen_ai_token_type}}",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum(codex_turn_token_usage_total)",
          "legendFormat": "Codex tokens",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80 },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "orientation": "horizontal",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "入力・出力トークン数",
      "description": "ツール別の入力・出力トークン内訳です。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(claude_code_token_usage_tokens_total{type=\"input\"})",
          "legendFormat": "Claude Code input",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum(claude_code_token_usage_tokens_total{type=\"output\"})",
          "legendFormat": "Claude Code output",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum(gen_ai_client_token_usage_sum{service_name=\"gemini-cli\", gen_ai_token_type=\"input\"})",
          "legendFormat": "Gemini input",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum(gen_ai_client_token_usage_sum{service_name=\"gemini-cli\", gen_ai_token_type=\"output\"})",
          "legendFormat": "Gemini output",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80 },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "orientation": "vertical",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "stacking": "normal",
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "効率とコスト",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "stat",
      "title": "入力・出力比（Claude Code）",
      "description": "入力トークンと出力トークンの比です。作業内容によって変わります。",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(claude_code_token_usage_tokens_total{type=\"input\"}) / clamp_min(sum(claude_code_token_usage_tokens_total{type=\"output\"}), 1)",
          "legendFormat": "I/O Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] },
          "color": { "mode": "thresholds" },
          "unit": "short",
          "noValue": "N/A"
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "入力・出力比（Gemini）",
      "description": "Gemini CLI の入力トークンと出力トークンの比です。",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(gen_ai_client_token_usage_sum{service_name=\"gemini-cli\", gen_ai_token_type=\"input\"}) / clamp_min(sum(gen_ai_client_token_usage_sum{service_name=\"gemini-cli\", gen_ai_token_type=\"output\"}), 1)",
          "legendFormat": "I/O Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] },
          "color": { "mode": "thresholds" },
          "unit": "short",
          "noValue": "N/A"
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "合計コスト（Claude Code）",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(claude_code_cost_usage_USD_total)",
          "legendFormat": "Cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] },
          "color": { "mode": "thresholds" },
          "unit": "currencyUSD",
          "noValue": "$0.00"
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "キャッシュヒット率（Claude Code）",
      "description": "入力とキャッシュ読み取りの合計に対する、キャッシュ読み取りの割合です。キャッシュ書き込みは分母に含みません。",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "claude_code:cache_hit_rate",
          "legendFormat": "Cache %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 60 }] },
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "noValue": "N/A"
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "コストの推移（Claude Code）",
      "description": "Claude Code の毎秒あたりの平均コスト増加額（米ドル／秒）の推移です。直近5分間の平均で、総費用ではありません。",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (rate(claude_code_cost_usage_USD_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "stacking": { "mode": "normal" } },
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] } }
    }
  ]
}
